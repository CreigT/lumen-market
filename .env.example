STORE_NAME=Lumen Market
SUPPORT_EMAIL=hello@yourdomain.com
PUBLIC_BASE_URL=https://your-project.vercel.app

# Leave blank to stay in demo mode. No card is charged.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Create these Prices in Stripe, then paste the price_ ids.
STRIPE_PRICE_HOUSEHOLD=
STRIPE_PRICE_ATELIER=
STRIPE_PRICE_TOTE=
STRIPE_PRICE_CARAFE=
STRIPE_PRICE_THROW=
STRIPE_PRICE_NOTES=

# Optional. Events are also written to Vercel logs.
AGENT_WEBHOOK_URL=
AGENT_WEBHOOK_SECRET=

# Money Loop Sheet logging. Leave blank for no writes. Set on Vercel only.
GOOGLE_SERVICE_ACCOUNT=
MONEY_LOOP_SHEET_ID=
